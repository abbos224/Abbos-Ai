PORT=4000
STORAGE_DIR=storage

# Get from https://console.anthropic.com (API Keys section)
ANTHROPIC_API_KEY=

# Get from https://www.assemblyai.com (dashboard, after signup)
ASSEMBLYAI_API_KEY=

# Get from https://www.pexels.com/api/ (free, after signup) — used for B-roll stock footage
PEXELS_API_KEY=

# Get from https://devportal.jamendo.com (free, after signup) — used for mood-based background music
JAMENDO_CLIENT_ID=

# Get from https://console.cloud.google.com (APIs & Services > Credentials, OAuth client ID,
# "Web application" type) — used to publish rendered clips directly to YouTube.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:4000/oauth/youtube/callback

# Get from https://console.cloud.google.com (APIs & Services > Credentials, OAuth client ID,
# "Web application" type) — used for "Continue with Google" sign-in. Since the mobile app runs in
# Expo Go (no custom URL scheme), Google's redirect lands on this SERVER, not the phone directly —
# and since the redirect is followed by the phone's own browser, GOOGLE_REDIRECT_URI can't just be
# http://localhost:...: on the phone "localhost" means the phone itself. Google also requires
# HTTPS for any redirect host other than localhost. For local dev, expose this server with a
# tunnel (e.g. `cloudflared tunnel --url http://localhost:4000`, no account needed) and use its
# https://...trycloudflare.com URL here AND as an Authorized redirect URI on the OAuth client —
# note this URL changes every time the tunnel restarts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Get from https://aistudio.google.com/apikey — used for AI image generation/editing ("Nano
# Banana"). Free tier exists for dev/testing, but real usage has real per-call cost (unlike
# Anthropic, which this app already pays for regardless) — check current pricing at
# ai.google.dev before this goes beyond personal testing.
GEMINI_API_KEY=

# Get from https://resend.com/api-keys (after signup) — used to send the password-reset and
# email-verification codes. RESEND_FROM_EMAIL must be a verified sender/domain in the Resend
# dashboard, or every send will fail. (SendGrid was the original pick here but rejected account
# activation during signup with no actionable reason — Resend has a much smoother signup flow.)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# A local PostgreSQL instance (e.g. `winget install PostgreSQL.PostgreSQL.17`, then
# `createdb reelai`) — used for user accounts.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reelai
# Any long random string — used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
