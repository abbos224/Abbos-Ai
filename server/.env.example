PORT=4000
STORAGE_DIR=storage

# Get from https://console.anthropic.com (API Keys section)
ANTHROPIC_API_KEY=

# Get from https://www.assemblyai.com (dashboard, after signup)
ASSEMBLYAI_API_KEY=

# Get from https://www.pexels.com/api/ (free, after signup) — used for B-roll stock footage
PEXELS_API_KEY=

# Get from https://devportal.jamendo.com (free, after signup) — used for mood-based background music
JAMENDO_CLIENT_ID=

# Get from https://console.cloud.google.com (APIs & Services > Credentials, OAuth client ID,
# "Web application" type) — used to publish rendered clips directly to YouTube.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:4000/oauth/youtube/callback
